# PostgreSQL (used by Docker Compose and the backend)
POSTGRES_DB=sinhaspeech
POSTGRES_USER=sinhaspeech
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Authentication
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API and uploaded media
CORS_ORIGINS=http://localhost:5173
MEDIA_STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=104857600

# Transcription: fake or speak_asr
TRANSCRIBER_BACKEND=speak_asr
WHISPER_BASE_MODEL=openai/whisper-small
WHISPER_ADAPTER_MODEL=SPEAK-ASR/whisper-si-exp-10

## If using basline whisper without hf lora
# TRANSCRIBER_BACKEND=whisper
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=si

# MLflow (used by Docker Compose; shared fine-tuning experiment tracker)
# Port the tracking server listens on. It's bound to 0.0.0.0 (not 127.0.0.1
# like postgres) so remote GPU pods can reach it -- see final-scripts/README.md
# for the security tradeoff this implies and how to restrict access.
MLFLOW_PORT=5000
