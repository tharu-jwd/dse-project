# PostgreSQL (used by Docker Compose and the backend)
POSTGRES_DB=sinhaspeech
POSTGRES_USER=sinhaspeech
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Authentication
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API and uploaded media
CORS_ORIGINS=http://localhost:5173
MEDIA_STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_BYTES=104857600

VOICE_SAMPLES_DIR=storage/voice_samples

# Transcription: fake or speak_asr
TRANSCRIBER_BACKEND=speak_asr
WHISPER_BASE_MODEL=openai/whisper-small
WHISPER_ADAPTER_MODEL=SPEAK-ASR/whisper-si-exp-10

## If using basline whisper without hf lora
# TRANSCRIBER_BACKEND=whisper
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=si

## The locally fine-tuned Sinhala checkpoint (what deployment uses).
## WHISPER_MODEL is the HF-format model the background worker loads for
## uploaded files; STREAMING_MODEL_PATH is the smaller CTranslate2 build
## the live WebSocket path loads at startup. Both live under models/.
# TRANSCRIBER_BACKEND=whisper
# WHISPER_MODEL=models/whisper-sinhala1
# WHISPER_LANGUAGE=si

# Live streaming (WebSocket transcription) and voice commands.
# Both default to false in code - leave them unset and the microphone
# features silently do nothing, with no error. Set them to true to run
# the app as it is actually used.
STREAMING_ENABLED=true
VOICE_COMMAND_EMBEDDING_MATCHING_ENABLED=true
